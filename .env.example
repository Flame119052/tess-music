# Tess Music environment variables template (safe to commit — NEVER put real secrets here).
# Copy to `.env` for local overrides, and keep real key files in `~/.config/tess-signing/` (chmod 600).
#
# IMPORTANT: If the repo is on an external drive mounted with `noowners`, do NOT put raw private keys
# in a `.env` file inside the repo folder; leave them in `~/.config/tess-signing/` instead.

# --- Installer / testing (local) ------------------------------------------------------------------
# Channel for installer testing: stable | beta | dev
TESS_CHANNEL=dev

# Sandbox installer/updater testing (set TESS_TEST=1 and point all three to a scratch copy)
# TESS_TEST=1
# TESS_HOME=/tmp/tess-test-home
# TESS_CONFIG=/tmp/tess-test-config
# TESS_SPOTIFY=/tmp/Spotify-test.app

# --- Release & signing (CI secrets in GitHub Actions; locally read from ~/.config/tess-signing/) ---
# Ed25519 release signing private key (PEM). GitHub Actions secret: TESS_SIGNING_KEY
# TESS_SIGNING_KEY=

# Base64-encoded "Tess Music" .p12 code-signing identity + passphrase.
# GitHub Actions secrets: TESS_CODESIGN_P12, TESS_CODESIGN_PASS
# TESS_CODESIGN_P12=
# TESS_CODESIGN_PASS=

# SSH deploy key path (local) or key contents (GitHub Actions secret: TESS_MIRROR_KEY)
# for pushing promoted builds to Flame119052/tess-releases
# TESS_MIRROR_KEY_FILE=

# --- Cloudflare Worker (`inbox/`) -----------------------------------------------------------------
# Managed via `npx wrangler@4 login` and `npx wrangler@4 secret put SALT` (in `inbox/`).
# For local `wrangler dev`, put `SALT=...` inside `inbox/.dev.vars` (gitignored).
