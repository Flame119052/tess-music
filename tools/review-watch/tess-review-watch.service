# User unit: one watcher tick, then stop. Started by tess-review-watch.timer.
# Install under ~/.config/systemd/user/ ; see README.md in this folder. Nothing here is system-wide, and the watcher
# holds no credential: it uses this account's own gh and t3 sign-ins.
[Unit]
Description=Open Tess review tags that name this machine as T3 threads
Documentation=https://github.com/Flame119052/tess-music/blob/main/tools/review-watch/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/tess-review-watch/src
ExecStart=/bin/sh -lc 'cd "$HOME/.local/share/tess-review-watch/src" && exec node tools/review-watch/watch.mjs'
# A review thread is started by T3, not here, so this stays small and cheap. The timeout is for the GitHub reads.
Nice=10
TimeoutStartSec=180
