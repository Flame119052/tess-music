# User timer: one watcher tick every 2 minutes, and 2 minutes after login.
# Install under ~/.config/systemd/user/ ; see README.md in this folder.
[Unit]
Description=Open Tess review tags that name this machine every 2 minutes

[Timer]
OnBootSec=2min
OnStartupSec=2min
OnUnitActiveSec=2min
AccuracySec=20s
RandomizedDelaySec=15
Persistent=false

[Install]
WantedBy=timers.target
