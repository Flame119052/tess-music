# User unit: publish this machine's usage snapshot once, then stop. Started by tess-usage-publish.timer.
# Install under ~/.config/systemd/user/ ; see README.md in this folder. Nothing here is system-wide, and nothing here
# touches anything but this account's own ~/.local/bin and its own GitHub token.
[Unit]
Description=Publish this machine's Tess usage snapshot (quota only)
Documentation=https://github.com/Flame119052/tess-music/blob/main/tools/usage-publish/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --machine picks the repository variable: USAGE_SNAPSHOT_VPS or USAGE_SNAPSHOT_OMARCHY. Change it in the installed copy.
ExecStart=/bin/sh -lc 'exec "$HOME/.local/bin/tess-usage-publish" --machine vps'
# Paperclip comes first on the VPS: the read is small, but it must never compete for a core or a disk.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
IOSchedulingPriority=7
MemoryMax=192M
TimeoutStartSec=180
